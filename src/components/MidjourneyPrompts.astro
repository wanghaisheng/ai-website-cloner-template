---
// Midjourney Prompts Component
interface PromptStyle {
  name: string;
  styles: string[];
  href: string;
}

const midjourneyPrompts: PromptStyle[] = [
  {
    name: "Master Midjourney Prompts",
    styles: ["Dreamy", "Surreal", "Ethereal", "Pointillism", "Painterly"],
    href: "/midjourney-library/sref/cosmic-pointillist-dreamscapes"
  },
  {
    name: "--sref 4215135847",
    styles: ["Dreamy", "Surreal", "Ethereal", "Pointillism", "Painterly"],
    href: "/midjourney-library/sref/cosmic-pointillist-dreamscapes"
  },
  {
    name: "Ghada Amer's painting depicting …",
    styles: ["Mixed Media", "Expressive", "Textured", "Line art", "Contemporary"],
    href: "/midjourney-library/prompt/ghada-amer"
  },
  {
    name: "Knolling",
    styles: ["bird's eye view", "Grid", "Geometric", "Photography", "Still Life"],
    href: "/midjourney-library/prompt/knolling"
  },
  {
    name: "--sref 3210822185",
    styles: ["Engraved", "Illustration", "Folk Art", "Bold lines"],
    href: "/midjourney-library/sref/engraved-imaginarium"
  },
  {
    name: "--sref 2776475560",
    styles: ["Black and White", "High Contrast", "Highly Detailed", "Photography", "Textured"],
    href: "/midjourney-library/sref/high-fidelity-monotone"
  },
  {
    name: "--sref 371907735",
    styles: ["Serene", "Illustration", "Floral", "Dreamy", "Asian"],
    href: "/midjourney-library/sref/serene-floral-dreams"
  }
];
---

<section class="py-16 bg-gray-50">
  <div class="container">
    <!-- Section Header -->
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
        Master Midjourney Prompts
      </h2>
      <p class="text-lg text-gray-600 mb-6">
        Explore curated Midjourney prompts and style references for stunning AI art
      </p>
      <a href="/midjourney-library" class="btn btn-primary">
        View More
      </a>
    </div>

    <!-- Prompt Showcase Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      {midjourneyPrompts.map((prompt, index) => (
        <div class="card hover:shadow-lg transition-all duration-200 animate-fade-in" style={`animation-delay: ${index * 0.1}s`}>
          <!-- SREF Code -->
          <h3 class="text-xl font-semibold text-gray-900 mb-4 font-mono bg-gray-100 px-3 py-2 rounded">
            {prompt.name}
          </h3>

          <!-- Style Tags Grid -->
          <div class="flex flex-wrap gap-2 mb-4">
            {prompt.styles.map((style) => (
              <span class="inline-block px-3 py-1 text-sm font-medium text-blue-700 bg-blue-100 rounded-full hover:bg-blue-200 transition-colors cursor-pointer">
                {style}
              </span>
            ))}
          </div>

          <!-- View Prompt Link -->
          <a 
            href={prompt.href} 
            class="inline-flex items-center text-blue-600 hover:text-blue-700 font-medium"
          >
            View Prompt Details
            <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      ))}
    </div>

    <!-- Additional Features -->
    <div class="mt-16 grid grid-cols-1 md:grid-cols-3 gap-8">
      <div class="text-center">
        <div class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4">
          <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253" />
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-gray-900 mb-2">Curated Prompts</h3>
        <p class="text-gray-600">Hand-picked Midjourney prompts from the community</p>
      </div>

      <div class="text-center">
        <div class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4">
          <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-gray-900 mb-2">Style References</h3>
        <p class="text-gray-600">Comprehensive SREF codes and style guides</p>
      </div>

      <div class="text-center">
        <div class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4">
          <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-gray-900 mb-2">Community Favorites</h3>
        <p class="text-gray-600">Most loved and used prompts by artists</p>
      </div>
    </div>
  </div>
</section>

<script>
  // Add click handlers for style tags
  const styleTags = document.querySelectorAll('.bg-blue-100');
  styleTags.forEach(tag => {
    tag.addEventListener('click', () => {
      // In a real implementation, this would filter or navigate to styles
      console.log('Style tag clicked:', tag.textContent);
    });
  });
</script>
