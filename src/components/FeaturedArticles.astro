---
// Featured Articles Component
interface Article {
  title: string;
  excerpt: string;
  category: string;
  date: string;
  readTime: string;
  href: string;
}

const featuredArticles: Article[] = [
  {
    title: "13 Reasons to Switch from Snapchat to Text Messaging",
    excerpt: "Discover why text messaging is becoming the preferred communication method over Snapchat for many users.",
    category: "Communication",
    date: "2024-03-15",
    readTime: "5 min read",
    href: "/top-ai-tools/13-reasons-to-switch-from-snapchat-to-text-messaging"
  },
  {
    title: "7 Powerful Speech to Text Apps to Boost Productivity",
    excerpt: "Explore the best speech-to-text applications that can significantly improve your workflow and productivity.",
    category: "Productivity",
    date: "2024-03-14",
    readTime: "7 min read",
    href: "/top-ai-tools/7-powerful-speech-to-text-apps-to-boost-productivity"
  },
  {
    title: "10 Best Speech to Text Tools for Effortless Transcription",
    excerpt: "Comprehensive review of the top speech-to-text tools that make audio transcription simple and accurate.",
    category: "Transcription",
    date: "2024-03-13",
    readTime: "8 min read",
    href: "/top-ai-tools/10-best-speech-to-text-tools-for-effortless-transcription"
  },
  {
    title: "13 Free Tools to Easily Transcribe Audio to Text",
    excerpt: "Free and effective tools for converting audio content into text without breaking the bank.",
    category: "Free Tools",
    date: "2024-03-12",
    readTime: "6 min read",
    href: "/top-ai-tools/13-free-tools-to-easily-transcribe-audio-to-text"
  },
  {
    title: "15 Surprising Ways Google's Speech-to-Text Boosts Productivity",
    excerpt: "How Google's speech recognition technology can transform your daily workflow and efficiency.",
    category: "Google",
    date: "2024-03-11",
    readTime: "9 min read",
    href: "/top-ai-tools/15-surprising-ways-google-s-speech-to-text-boosts-productivity"
  },
  {
    title: "7 Best Free Online Audio to Text Transcription Tools",
    excerpt: "Top free online tools that can accurately transcribe your audio files into text format.",
    category: "Online Tools",
    date: "2024-03-10",
    readTime: "5 min read",
    href: "/top-ai-tools/7-best-free-online-audio-to-text-transcription-tools"
  }
];

function formatDate(dateString: string): string {
  const date = new Date(dateString);
  return date.toLocaleDateString('en-US', { 
    month: 'short', 
    day: 'numeric', 
    year: 'numeric' 
  });
}
---

<section class="py-16 bg-white">
  <div class="container">
    <!-- Section Header -->
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
        Featured*
      </h2>
      <p class="text-lg text-gray-600">
        Hand-picked articles and guides to help you make the most of AI tools
      </p>
    </div>

    <!-- Articles Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {featuredArticles.map((article, index) => (
        <article class="card hover:shadow-lg transition-all duration-200 group animate-fade-in" style={`animation-delay: ${index * 0.1}s`}>
          <!-- Article Image Placeholder -->
          <div class="mb-4">
            <div class="w-full h-48 bg-gradient-to-br from-blue-100 to-indigo-100 rounded-lg flex items-center justify-center group-hover:from-blue-200 group-hover:to-indigo-200 transition-all duration-200">
              <svg class="w-16 h-16 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253" />
              </svg>
            </div>
          </div>

          <!-- Category Badge -->
          <div class="mb-2">
            <span class="inline-block px-3 py-1 text-xs font-semibold text-blue-600 bg-blue-100 rounded-full">
              {article.category}
            </span>
          </div>

          <!-- Article Title -->
          <h3 class="text-xl font-semibold text-gray-900 mb-2 group-hover:text-blue-600 transition-colors line-clamp-2">
            <a href={article.href}>
              {article.title}
            </a>
          </h3>

          <!-- Meta Information -->
          <div class="flex items-center text-sm text-gray-600 mb-3">
            <time datetime={article.date}>
              {formatDate(article.date)}
            </time>
            <span class="mx-2">•</span>
            <span>{article.readTime}</span>
          </div>

          <!-- Excerpt -->
          <p class="text-gray-600 line-clamp-3 mb-4">
            {article.excerpt}
          </p>

          <!-- Read More Link -->
          <a 
            href={article.href} 
            class="inline-flex items-center text-blue-600 hover:text-blue-700 font-medium group-hover:translate-x-1 transition-all duration-200"
          >
            Read More
            <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </article>
      ))}
    </div>

    <!-- View All Button -->
    <div class="text-center mt-12">
      <a href="/featured" class="btn btn-secondary">
        View All Featured Articles
      </a>
    </div>
  </div>
</section>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
