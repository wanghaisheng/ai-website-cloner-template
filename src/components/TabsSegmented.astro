---
// Tabs and Segmented Controls Component
---

<!-- Tab Navigation -->
<div class="demo-section">
  <h3 class="text-xl font-semibold mb-4">Tab Navigation</h3>
  
  <div class="tabs-container">
    <div class="tab-nav">
      <button class="tab-btn active" data-tab="tab1" onclick="switchTab('tab1')">
        Overview
      </button>
      <button class="tab-btn" data-tab="tab2" onclick="switchTab('tab2')">
        Features
      </button>
      <button class="tab-btn" data-tab="tab3" onclick="switchTab('tab3')">
        Pricing
      </button>
      <button class="tab-btn" data-tab="tab4" onclick="switchTab('tab4')">
        Documentation
      </button>
    </div>
    
    <div class="tab-content">
      <div class="tab-pane active" id="tab1">
        <h4>Overview</h4>
        <p>This is the overview tab content. It provides a general introduction to the product or service being described.</p>
        <ul>
          <li>Key benefits and features</li>
          <li>Use cases and applications</li>
          <li>Getting started information</li>
        </ul>
      </div>
      
      <div class="tab-pane" id="tab2">
        <h4>Features</h4>
        <p>This tab highlights the main features of the product. Each feature is described in detail with examples.</p>
        <div class="feature-grid">
          <div class="feature-item">
            <h5>Feature 1</h5>
            <p>Description of the first feature and its benefits.</p>
          </div>
          <div class="feature-item">
            <h5>Feature 2</h5>
            <p>Description of the second feature and how it works.</p>
          </div>
          <div class="feature-item">
            <h5>Feature 3</h5>
            <p>Description of the third feature and its use cases.</p>
          </div>
        </div>
      </div>
      
      <div class="tab-pane" id="tab3">
        <h4>Pricing</h4>
        <p>Pricing information and subscription plans are detailed in this tab.</p>
        <div class="pricing-cards">
          <div class="pricing-card">
            <h5>Free Plan</h5>
            <div class="price">$0<span>/month</span></div>
            <ul class="pricing-features">
              <li>✓ Basic features</li>
              <li>✓ Community support</li>
              <li>✓ 5 projects</li>
            </ul>
            <button class="btn btn-secondary">Get Started</button>
          </div>
          <div class="pricing-card popular">
            <div class="pricing-badge">Most Popular</div>
            <h5>Pro Plan</h5>
            <div class="price">$29<span>/month</span></div>
            <ul class="pricing-features">
              <li>✓ All Free features</li>
              <li>✓ Priority support</li>
              <li>✓ Unlimited projects</li>
              <li>✓ Advanced analytics</li>
            </ul>
            <button class="btn btn-primary">Start Free Trial</button>
          </div>
          <div class="pricing-card">
            <h5>Enterprise</h5>
            <div class="price">Custom</div>
            <ul class="pricing-features">
              <li>✓ All Pro features</li>
            <li>✓ Dedicated support</li>
            <li>✓ Custom integrations</li>
            <li>✓ SLA guarantee</li>
            <li>✓ Training sessions</li>
            </ul>
            <button class="btn btn-secondary">Contact Sales</button>
          </div>
        </div>
      </div>
      
      <div class="tab-pane" id="tab4">
        <h4>Documentation</h4>
        <p>Comprehensive documentation and resources are available in this tab.</p>
        <div class="doc-links">
          <a href="#" class="doc-link">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253m0-13" />
            </svg>
            Getting Started
          </a>
          <a href="#" class="doc-link">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h12m2 4v-4m0 0l4-4m-4 4l-4-4m4 4V8" />
            </svg>
            API Reference
          </a>
          <a href="#" class="doc-link">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253m0-13" />
            </svg>
            Tutorials
          </a>
          <a href="#" class="doc-link">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253m0-13" />
            </svg>
            Examples
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Segmented Controls -->
<div class="demo-section">
  <h3 class="text-xl font-semibold mb-4">Segmented Controls</h3>
  
  <div class="segmented-controls">
    <div class="segmented-group">
      <button class="segmented-btn active" data-segment="grid" onclick="switchSegment('grid', this)">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2v12a2 2 0 012-2H6a2 2 0 01-2-2V6a2 2 0 012-2h12a2 2 0 012 2v12a2 2 0 01-2 2H6a2 2 0 01-2-2V6z" />
        </svg>
        Grid
      </button>
      <button class="segmented-btn" data-segment="list" onclick="switchSegment('list', this)">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        List
      </button>
      <button class="segmented-btn" data-segment="card" onclick="switchSegment('card', this)">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <rect x="3" y="4" width="18" height="16" rx="2" stroke="currentColor" stroke-width="2" />
        </svg>
        Card
      </button>
    </div>
    
    <div class="segmented-content">
      <div class="segmented-pane active" id="grid">
        <h4>Grid View</h4>
        <div class="demo-grid">
          <div class="demo-grid-item">Item 1</div>
          <div class="demo-grid-item">Item 2</div>
          <div class="demo-grid-item">Item 3</div>
          <div class="demo-grid-item">Item 4</div>
          <div class="demo-grid-item">Item 5</div>
          <div class="demo-grid-item">Item 6</div>
        </div>
      </div>
      
      <div class="segmented-pane" id="list">
        <h4>List View</h4>
        <div class="demo-list">
          <div class="demo-list-item">
            <div class="demo-list-icon">📄</div>
            <div class="demo-list-content">
              <h5>List Item 1</h5>
              <p>Description of the first list item with details and information.</p>
            </div>
          </div>
          <div class="demo-list-item">
            <div class="demo-list-icon">📄</div>
            <div class="demo-list-content">
              <h5>List Item 2</h5>
              <p>Description of the second list item with details and information.</p>
            </div>
          </div>
          <div class="demo-list-item">
            <div class="demo-list-icon">📄</div>
            <div class="demo-list-content">
              <h5>List Item 3</h5>
              <p>Description of the third list item with details and information.</p>
            </div>
          </div>
        </div>
      </div>
      
      <div class="segmented-pane" id="card">
        <h4>Card View</h4>
        <div class="demo-cards">
          <div class="demo-card">
            <div class="demo-card-header">
              <h5>Card 1</h5>
              <span class="demo-card-badge">New</span>
            </div>
            <div class="demo-card-content">
              <p>Content for the first card with description and details.</p>
            </div>
            <div class="demo-card-footer">
              <button class="btn btn-primary btn-sm">Action</button>
            </div>
          </div>
          <div class="demo-card">
            <div class="demo-card-header">
              <h5>Card 2</h5>
              <span class="demo-card-badge">Popular</span>
            </div>
            <div class="demo-card-content">
              <p>Content for the second card with description and details.</p>
            </div>
            <div class="demo-card-footer">
              <button class="btn btn-secondary btn-sm">Action</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
.demo-section {
  padding: var(--space-xl);
  border-bottom: 1px solid var(--color-border);
}

.demo-section:last-child {
  border-bottom: none;
}

/* Tab Styles */
.tabs-container {
  max-width: 800px;
}

.tab-nav {
  display: flex;
  border-bottom: 1px solid var(--color-border);
  margin-bottom: var(--space-lg);
  gap: var(--space-md);
}

.tab-btn {
  background: transparent;
  border: none;
  border-bottom: 2px solid transparent;
  padding: var(--space-md) var(--space-lg);
  color: var(--color-muted);
  font-weight: 500;
  cursor: pointer;
  transition: all 0.2s ease;
  position: relative;
}

.tab-btn:hover {
  color: var(--color-foreground);
}

.tab-btn.active {
  color: var(--color-primary);
  border-bottom-color: var(--color-primary);
}

.tab-content {
  padding: var(--space-lg) 0;
}

.tab-pane {
  display: none;
  animation: fadeIn 0.3s ease;
}

.tab-pane.active {
  display: block;
}

.tab-pane h4 {
  font-size: 1.25rem;
  font-weight: 600;
  margin-bottom: var(--space-md);
  color: var(--color-foreground);
}

.tab-pane p {
  color: var(--color-muted);
  line-height: 1.6;
  margin-bottom: var(--space-md);
}

.tab-pane ul {
  margin: 0;
  padding-left: var(--space-lg);
  color: var(--color-muted);
}

.tab-pane li {
  margin-bottom: var(--space-xs);
}

/* Feature Grid */
.feature-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: var(--space-lg);
  margin-top: var(--space-md);
}

.feature-item {
  padding: var(--space-md);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
}

.feature-item h5 {
  font-weight: 600;
  margin-bottom: var(--space-sm);
  color: var(--color-foreground);
}

.feature-item p {
  color: var(--color-muted);
  font-size: 0.875rem;
  line-height: 1.5;
}

/* Pricing Cards */
.pricing-cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: var(--space-lg);
  margin-top: var(--space-md);
}

.pricing-card {
  background: white;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: var(--space-lg);
  text-align: center;
  position: relative;
}

.pricing-card.popular {
  border-color: var(--color-primary);
  transform: scale(1.05);
}

.pricing-badge {
  position: absolute;
  top: -12px;
  left: 50%;
  transform: translateX(-50%);
  background: var(--color-primary);
  color: white;
  padding: var(--space-xs) var(--space-sm);
  border-radius: var(--radius-md);
  font-size: 0.75rem;
  font-weight: 600;
}

.pricing-card h5 {
  font-size: 1.25rem;
  font-weight: 600;
  margin-bottom: var(--space-sm);
}

.price {
  font-size: 2rem;
  font-weight: 700;
  color: var(--color-foreground);
  margin-bottom: var(--space-md);
}

.price span {
  font-size: 1rem;
  font-weight: 400;
  color: var(--color-muted);
}

.pricing-features {
  list-style: none;
  padding: 0;
  margin: var(--space-md) 0;
  text-align: left;
}

.pricing-features li {
  padding: var(--space-xs) 0;
  color: var(--color-muted);
  font-size: 0.875rem;
}

/* Doc Links */
.doc-links {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: var(--space-md);
  margin-top: var(--space-md);
}

.doc-link {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  padding: var(--space-md);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  text-decoration: none;
  color: var(--color-foreground);
  transition: all 0.2s ease;
}

.doc-link:hover {
  border-color: var(--color-primary);
  color: var(--color-primary);
}

/* Segmented Controls */
.segmented-controls {
  max-width: 800px;
}

.segmented-group {
  display: inline-flex;
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  padding: 2px;
  gap: 2px;
}

.segmented-btn {
  background: transparent;
  border: none;
  padding: var(--space-sm) var(--space-md);
  border-radius: var(--radius-sm);
  color: var(--color-muted);
  font-weight: 500;
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: var(--space-xs);
  transition: all 0.2s ease;
}

.segmented-btn:hover {
  color: var(--color-foreground);
}

.segmented-btn.active {
  background: white;
  color: var(--color-foreground);
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
}

.segmented-content {
  margin-top: var(--space-lg);
}

.segmented-pane {
  display: none;
  animation: fadeIn 0.3s ease;
}

.segmented-pane.active {
  display: block;
}

/* Demo Content Styles */
.demo-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
  gap: var(--space-md);
}

.demo-grid-item {
  padding: var(--space-md);
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  text-align: center;
  color: var(--color-muted);
}

.demo-list {
  space-y: var(--space-md);
}

.demo-list-item {
  display: flex;
  align-items: flex-start;
  gap: var(--space-md);
  padding: var(--space-md);
  background: white;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
}

.demo-list-icon {
  font-size: 1.5rem;
  flex-shrink: 0;
}

.demo-list-content h5 {
  font-weight: 600;
  margin-bottom: var(--space-xs);
  color: var(--color-foreground);
}

.demo-list-content p {
  color: var(--color-muted);
  font-size: 0.875rem;
  line-height: 1.5;
}

.demo-cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: var(--space-lg);
}

.demo-card {
  background: white;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  overflow: hidden;
}

.demo-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-md);
  border-bottom: 1px solid var(--color-border);
}

.demo-card-header h5 {
  font-weight: 600;
  margin: 0;
}

.demo-card-badge {
  background: var(--color-primary);
  color: white;
  padding: var(--space-xs) var(--space-sm);
  border-radius: var(--radius-sm);
  font-size: 0.75rem;
  font-weight: 500;
}

.demo-card-content {
  padding: var(--space-md);
}

.demo-card-content p {
  color: var(--color-muted);
  line-height: 1.5;
  margin: 0;
}

.demo-card-footer {
  padding: var(--space-md);
  border-top: 1px solid var(--color-border);
  display: flex;
  justify-content: center;
}

/* Responsive */
@media (max-width: 768px) {
  .tab-nav {
    flex-wrap: wrap;
    gap: var(--space-sm);
  }
  
  .tab-btn {
    padding: var(--space-sm) var(--space-md);
    font-size: 0.875rem;
  }
  
  .segmented-group {
    width: 100%;
    justify-content: stretch;
  }
  
  .segmented-btn {
    flex: 1;
  }
  
  .doc-links {
    grid-template-columns: 1fr;
  }
  
  .demo-grid {
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
  }
  
  .demo-cards {
    grid-template-columns: 1fr;
  }
}
</style>

<script>
  function switchTab(tabId: string) {
    // Hide all tabs
    const allPanes = document.querySelectorAll('.tab-pane');
    allPanes.forEach(pane => {
      pane.classList.remove('active');
    });
    
    // Remove active class from all buttons
    const allBtns = document.querySelectorAll('.tab-btn');
    allBtns.forEach(btn => {
      btn.classList.remove('active');
    });
    
    // Show selected tab
    const selectedPane = document.getElementById(tabId);
    if (selectedPane) {
      selectedPane.classList.add('active');
    }
    
    // Add active class to clicked button
    const selectedBtn = document.querySelector(`[data-tab="${tabId}"]`);
    if (selectedBtn) {
      selectedBtn.classList.add('active');
    }
  }

  function switchSegment(segmentId: string, button: HTMLButtonElement) {
    // Hide all panes
    const allPanes = document.querySelectorAll('.segmented-pane');
    allPanes.forEach(pane => {
      pane.classList.remove('active');
    });
    
    // Remove active class from all buttons
    const allBtns = document.querySelectorAll('.segmented-btn');
    allBtns.forEach(btn => {
      btn.classList.remove('active');
    });
    
    // Show selected pane
    const selectedPane = document.getElementById(segmentId);
    if (selectedPane) {
      selectedPane.classList.add('active');
    }
    
    // Add active class to clicked button
    if (button) {
      button.classList.add('active');
    }
  }
</script>
