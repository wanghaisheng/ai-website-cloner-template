    <!-- Bottom Section -->
    <div class="border-t border-gray-800 mt-8 pt-8">
      <div class="flex flex-col md:flex-row justify-between items-center">
        <div class="text-gray-400 text-sm">
          © 2024 Toolify. All rights reserved.
        </div>
        <div class="flex items-center space-x-4 text-sm text-gray-400">
          <span>Made with ❤️ for the AI community</span>
          <a href="#" class="hover:text-white transition-colors">Back to top ↑</a>
        </div>
      </div>
    </div>
  </div>
</footer>

<script>
  // Newsletter form handler
  const newsletterForm = document.querySelector('input[type="email"]').parentElement;
  const submitBtn = newsletterForm.querySelector('button');
  
  submitBtn?.addEventListener('click', (e) => {
    e.preventDefault();
    const email = newsletterForm.querySelector('input[type="email"]').value;
    if (email) {
      alert(`Thank you for subscribing with email: ${email}`);
      newsletterForm.querySelector('input[type="email"]').value = '';
    }
  });

  // Back to top functionality
  const backToTopBtn = document.querySelector('a[href="#"]');
  backToTopBtn?.addEventListener('click', (e) => {
    e.preventDefault();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
</script>
